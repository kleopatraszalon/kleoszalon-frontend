{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/resource-timegrid": "^6.1.19",
    "@fullcalendar/resource-timeline": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "axios": "^1.13.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-calendar": "^6.0.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "7.18.2",
    "recharts": "^2.15.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "start:vite": "vite",
    "prebuild": "node scripts/write-release-meta.js",
    "build": "vite build --outDir build",
    "postbuild": "node scripts/normalize-vite-manifest.js build",
    "build:vite": "node scripts/write-release-meta.js && vite build --outDir dist-vite",
    "postbuild:vite": "node scripts/normalize-vite-manifest.js dist-vite",
    "preview:vite": "vite preview --outDir build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint:strict": "node scripts/run-release-lint.js",
    "quality:strict": "npm run typecheck && npm run lint:strict",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-calendar": "^3.9.0",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
